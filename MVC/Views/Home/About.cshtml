@{
    ViewBag.Title = "Acerca de";
}

<div class="encabezado">
    <div>
        <h2>Acerca de</h2>
        <p class="subtitulo">@ViewBag.Message</p>
    </div>
</div>

<div class="row">
    <div class="four columns">
        <div class="tarjeta">
            <h5>📦 Modelo</h5>
            <p>Las clases Cliente, Técnico, Electrodoméstico y Reparación, con sus datos de ejemplo en <code>Datos.cs</code>.</p>
        </div>
    </div>
    <div class="four columns">
        <div class="tarjeta">
            <h5>🖥️ Vista</h5>
            <p>Las páginas en Razor (<code>.cshtml</code>) que ve el usuario: listados, formularios y detalles.</p>
        </div>
    </div>
    <div class="four columns">
        <div class="tarjeta">
            <h5>🎛️ Controlador</h5>
            <p>Recibe cada petición, toma los datos del modelo y decide qué vista mostrar.</p>
        </div>
    </div>
</div>

<div class="tarjeta">
    <p style="margin:0">Taller en clase de ASP.NET MVC 5 (.NET Framework). El diseño está hecho con el framework CSS <strong>Skeleton</strong>.</p>
</div>
