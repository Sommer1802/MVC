@{
    ViewBag.Title = "Contacto";
}

<div class="encabezado">
    <div>
        <h2>Contacto</h2>
        <p class="subtitulo">@ViewBag.Message</p>
    </div>
</div>

<div class="row">
    <div class="six columns">
        <div class="tarjeta">
            <h5>📍 Dirección</h5>
            <p style="margin:0">Barranquilla, Atlántico</p>
        </div>
    </div>
    <div class="six columns">
        <div class="tarjeta">
            <h5>📞 Atención al cliente</h5>
            <p style="margin:0">Lunes a sábado, 8:00 a. m. a 6:00 p. m.</p>
        </div>
    </div>
</div>
