@model MVC.Models.Electrodomesticos

@{
    ViewBag.Title = "Electrodoméstico registrado";
}

<div class="exito">✔ El electrodoméstico se registró correctamente.</div>

<div class="tarjeta">
    <h4>@Model.Tipo @Model.Modelo</h4>
    <table class="u-full-width detalle">
        <tr><th>Tipo</th><td>@Model.Tipo</td></tr>
        <tr><th>Modelo</th><td>@Model.Modelo</td></tr>
        <tr><th>Precio</th><td class="dinero">$ @Model.Precio.ToString("N0")</td></tr>
    </table>
</div>

@Html.ActionLink("Ver listado", "Index", null, new { @class = "button button-primary" })
@Html.ActionLink("Registrar otro", "Crear", null, new { @class = "button" })
