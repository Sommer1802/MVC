@model MVC.Models.Cliente

@{
    ViewBag.Title = "Nuevo cliente";
}

<div class="encabezado">
    <div>
        <h2>Nuevo cliente</h2>
        <p class="subtitulo">Ingrese los datos del cliente</p>
    </div>
</div>

<div class="tarjeta">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "error" })

        <div class="row">
            <div class="six columns campo">
                @Html.LabelFor(m => m.Nombre)
                @Html.TextBoxFor(m => m.Nombre, new { @class = "u-full-width" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "error" })
            </div>
            <div class="six columns campo">
                @Html.LabelFor(m => m.Apellidos)
                @Html.TextBoxFor(m => m.Apellidos, new { @class = "u-full-width" })
                @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "error" })
            </div>
        </div>
        <div class="row">
            <div class="six columns campo">
                @Html.LabelFor(m => m.DNI)
                @Html.TextBoxFor(m => m.DNI, new { @class = "u-full-width" })
                @Html.ValidationMessageFor(m => m.DNI, "", new { @class = "error" })
            </div>
            <div class="six columns campo">
                @Html.LabelFor(m => m.Telefono)
                @Html.TextBoxFor(m => m.Telefono, new { @class = "u-full-width" })
            </div>
        </div>
        <div class="campo">
            @Html.LabelFor(m => m.Direccion)
            @Html.TextBoxFor(m => m.Direccion, new { @class = "u-full-width" })
        </div>

        <div class="botones-formulario">
            <input type="submit" class="button-primary" value="Guardar" />
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "button" })
        </div>
    }
</div>
