@model MVC.Models.Tecnico

@{
    ViewBag.Title = "Nuevo técnico";
}

<div class="encabezado">
    <div>
        <h2>Nuevo técnico</h2>
        <p class="subtitulo">Ingrese los datos del técnico</p>
    </div>
</div>

<div class="tarjeta">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "error" })

        <div class="row">
            <div class="six columns campo">
                @Html.LabelFor(m => m.Nombre)
                @Html.TextBoxFor(m => m.Nombre, new { @class = "u-full-width" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "error" })
            </div>
            <div class="six columns campo">
                @Html.LabelFor(m => m.Apellidos)
                @Html.TextBoxFor(m => m.Apellidos, new { @class = "u-full-width" })
                @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "error" })
            </div>
        </div>
        <div class="row">
            <div class="six columns campo">
                @Html.LabelFor(m => m.NIF)
                @Html.TextBoxFor(m => m.NIF, new { @class = "u-full-width", placeholder = "Código del técnico, ej. 003" })
                @Html.ValidationMessageFor(m => m.NIF, "", new { @class = "error" })
            </div>
            <div class="six columns campo">
                @Html.LabelFor(m => m.Movil)
                @Html.TextBoxFor(m => m.Movil, new { @class = "u-full-width" })
            </div>
        </div>

        <div class="botones-formulario">
            <input type="submit" class="button-primary" value="Guardar" />
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "button" })
        </div>
    }
</div>
